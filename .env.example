# =============================================================================
# SignalMiner Configuration
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Application ---
APP_NAME=SignalMiner
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- LLM Providers ---
# At least one provider must be configured.

# OpenAI (or OpenAI-compatible endpoint like OpenRouter)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=              # Leave empty for default OpenAI, or set to e.g. https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini      # Model for structured extraction
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-lite

# DeepSeek (deepseek-flash supports text + image multimodal)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Qwen (Alibaba)
QWEN_API_KEY=
QWEN_MODEL=qwen-max

# MiniMax
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=abab6.5-chat

# Default LLM provider: "openai" | "google" | "deepseek" | "qwen" | "minimax"
DEFAULT_LLM_PROVIDER=deepseek

# --- Decoupled Embedding Vector Model (configurable in Web UI -> 模型设置) ---
# Options: "local_fastembed" (free local BGE-small-zh), "openai_compatible" (SiliconFlow/DashScope/Zhipu/OpenAI), "auto", "disabled"
EMBEDDING_PROVIDER=local_fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Database ---
# SQLite (development) — just a file path
DATABASE_URL=sqlite+aiosqlite:///./signal_miner.db

# PostgreSQL (production) — uncomment and configure
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/signal_miner

# --- State Store ---
# "auto" tries Redis, falls back to memory. "redis" or "memory" to force.
STATE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# --- Pipeline ---
EXTRACTION_CONFIDENCE_THRESHOLD=0.5
MAX_SIGNALS_PER_FEEDBACK=5
SIMILARITY_VOTE_THRESHOLD=0.8
SIMILARITY_MIN_THRESHOLD=0.55

# --- Authentication ---
# Leave empty for development mode (no auth required)
API_KEY=

# --- Connectors ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WEBHOOK_SECRET=your_webhook_signing_secret
